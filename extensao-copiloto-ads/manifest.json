{
  "manifest_version": 3,
  "name": "Copiloto de Tráfego ARS — Gerenciador de Anúncios",
  "version": "0.2.0",
  "description": "O copiloto de tráfego da Academia das Redes Sociais: IA que lê as métricas do Gerenciador de Anúncios e devolve diagnóstico, otimizações e novas campanhas com base nas suas metas.",
  "icons": {
    "16": "icones/icone-16.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://adsmanager.facebook.com/*",
        "https://business.facebook.com/adsmanager/*",
        "https://business.facebook.com/latest/ad_center/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Copiloto de Tráfego — abrir configurações",
    "default_icon": {
      "16": "icones/icone-16.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icones/*",
        "fontes/*"
      ],
      "matches": [
        "https://adsmanager.facebook.com/*",
        "https://business.facebook.com/*"
      ]
    }
  ]
}