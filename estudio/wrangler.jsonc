// Estúdio 72h · Configuração da Cloudflare (Workers + assets estáticos)
// Deploy: dentro desta pasta, rode `wrangler deploy` (veja o README).
{
  "name": "estudio72h",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }

  // MODELOS DA EQUIPE (recomendado): para os modelos criados no app valerem
  // para todos os designers, crie o KV e descomente o bloco abaixo com o id
  // que o comando devolver:
  //   npx wrangler kv namespace create MODELOS
  //
  // ,"kv_namespaces": [
  //   { "binding": "MODELOS", "id": "COLE_AQUI_O_ID_GERADO" }
  // ]

  // A chave da IA NÃO fica aqui: rode `wrangler secret put ANTHROPIC_API_KEY`
  // e `wrangler secret put ACCESS_CODES` após o primeiro deploy.
}
